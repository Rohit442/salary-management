    {
      "name": "11 — Record salary change",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{salaryOperationKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/employees/{{managedEmployeeId}}/salary-changes",
        "description": "Changes annual base salary and records history atomically. Effective date must follow the latest salary date and be on/before the UTC business date. A mid-month raise applies to the whole month. Clear salaryOperationKey for a new intent; retries preserve the original resolved body and version.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"annualBaseSalary\": \"1080000.00\",\n  \"effectiveDate\": \"2026-10-15\",\n  \"reason\": \"Annual compensation review\",\n  \"version\": {{employeeVersion}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const token = pm.collectionVariables.get(\"csrfToken\");",
              "if (!token) {",
              "  pm.execution.setNextRequest(null);",
              "  pm.execution.skipRequest();",
              "  throw new Error(\"Run login and refresh CSRF first; keep the cookie jar enabled.\");",
              "}",
              "pm.request.headers.upsert({ key: \"X-CSRF-TOKEN\", value: token });",
              "let operationKey = pm.collectionVariables.get(\"salaryOperationKey\");",
              "if (!operationKey) {",
              "  operationKey = pm.variables.replaceIn(\"{{$guid}}\").toLowerCase();",
              "  pm.collectionVariables.set(\"salaryOperationKey\", operationKey);",
              "  pm.collectionVariables.set(\"salaryOperationBody\", pm.variables.replaceIn(pm.request.body.raw));",
              "}",
              "const savedBody = pm.collectionVariables.get(\"salaryOperationBody\");",
              "if (!savedBody) { pm.execution.setNextRequest(null); pm.execution.skipRequest(); throw new Error(\"Clear salaryOperationKey to start a new salary operation with a captured body.\"); }",
              "pm.request.headers.upsert({ key: \"Idempotency-Key\", value: operationKey });",
              "pm.request.body.update(savedBody);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Salary change returns 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  pm.test(\"Salary outcome includes history and replay information\", function () {",
              "    pm.expect(body.employeeId).to.equal(pm.collectionVariables.get(\"managedEmployeeId\"));",
              "    pm.expect(body.changeId).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(body.previousAmount).to.be.a(\"string\");",
              "    pm.expect(body.newAmount).to.be.a(\"string\");",
              "    pm.expect(Number.isSafeInteger(body.resultingEmployeeVersion)).to.equal(true);",
              "    pm.expect(pm.response.headers.get(\"Idempotency-Replayed\")).to.be.oneOf([\"true\", \"false\"]);",
              "  });",
              "  if (pm.response.headers.get(\"Idempotency-Replayed\") === \"false\" && Number.isSafeInteger(body.resultingEmployeeVersion)) {",
              "    pm.collectionVariables.set(\"employeeVersion\", String(body.resultingEmployeeVersion));",
              "  }",
              "}"
            ]
          }
        }
      ],
      "response": [],
      "protocolProfileBehavior": {
        "disableCookies": false,
        "followRedirects": false
      }
    },
