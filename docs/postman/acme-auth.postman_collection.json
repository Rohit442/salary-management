      "value": "0",
      "type": "string",
      "description": "Version reviewed for the managed employee; updated only by successful employee writes."
    },
    {
      "key": "salaryOperationKey",
      "value": "",
      "type": "string",
      "description": "Generated once for a salary operation. Clear for a new intent; retain for retries."
    },
    {
      "key": "salaryOperationBody",
      "value": "",
      "type": "string",
      "description": "Resolved salary payload retained with its operation key for equivalent retries."
    },
    {
      "key": "estimateMonth",
      "value": "2026-11",
      "type": "string",
      "description": "Calendar month in YYYY-MM format."
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Response is not cached\", function () {",
          "  pm.expect(pm.response.headers.get(\"Cache-Control\") || \"\").to.include(\"no-store\");",
          "});",
          "pm.test(\"Response has a server request UUID\", function () {",
          "  pm.expect(pm.response.headers.get(\"X-Request-ID\") || \"\").to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
          "});",
          "if (pm.response.code !== 204) {",
          "  pm.test(\"Response is JSON\", function () {",
          "    pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\");",
          "  });",
          "}",
          "if (pm.response.code >= 400) {",
          "  pm.collectionVariables.unset(\"csrfToken\");",
          "  pm.execution.setNextRequest(null);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 — Get CSRF before login",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/csrf",
        "description": "Creates an anonymous session. Saves its token for request 2."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"CSRF issuance returns 200\", function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.unset(\"csrfToken\");",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test(\"CSRF response contains the token and expected header\", function () {",
              "    pm.expect(body.token).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(body.headerName).to.equal(\"X-CSRF-TOKEN\");",
              "  });",
              "  if (typeof body.token === \"string\" && body.token.length > 0 && body.headerName === \"X-CSRF-TOKEN\") {",
              "    pm.collectionVariables.set(\"csrfToken\", body.token);",
              "  } else {",
              "    pm.execution.setNextRequest(null);",
              "  }",
              "}"
            ]
          }
        }
      ],
      "response": [],
      "protocolProfileBehavior": {
        "disableCookies": false,
        "followRedirects": false
      }
    },
    {
      "name": "02 — Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "description": "Form-encoded HR credentials plus the initial token. Cookie jar receives the rotated session cookie. Run request 3 next.",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "email",
              "value": "{{email}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const token = pm.collectionVariables.get(\"csrfToken\");",
              "if (!token) {",
              "  pm.execution.setNextRequest(null);",
              "  pm.execution.skipRequest();",
              "  throw new Error(\"Run the appropriate Get CSRF request first. Keep Postman's cookie jar enabled.\");",
              "}",
              "pm.request.headers.upsert({ key: \"X-CSRF-TOKEN\", value: token });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Authenticated user response returns 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test(\"Response contains the HR identity and timeout\", function () {",
              "    pm.expect(body.user.id).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(body.user.email).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(body.user.displayName).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(body.user.roles).to.include(\"HR\");",
              "    pm.expect(body.idleTimeoutSeconds).to.be.a(\"number\").and.above(0);",
              "    pm.expect(body.user).not.to.have.property(\"password\");",
              "    pm.expect(body.user).not.to.have.property(\"passwordHash\");",
              "    pm.expect(body).not.to.have.property(\"sessionId\");",
              "  });",
              "}",
              "",
              "// Successful authentication invalidates the pre-login token. Step 3 retrieves its replacement.",
              "pm.collectionVariables.unset(\"csrfToken\");",
              "pm.test(\"Login does not redirect\", function () {",
              "  pm.expect(pm.response.headers.get(\"Location\")).to.not.be.ok;",
              "});"
            ]
          }
        }
      ],
      "response": [],
      "protocolProfileBehavior": {
        "disableCookies": false,
        "followRedirects": false
      }
    },
    {
      "name": "03 — Refresh CSRF after login",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/csrf",
        "description": "Gets the token belonging to the authenticated session. Required before logout or other writes."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"CSRF issuance returns 200\", function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.unset(\"csrfToken\");",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test(\"CSRF response contains the token and expected header\", function () {",
              "    pm.expect(body.token).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(body.headerName).to.equal(\"X-CSRF-TOKEN\");",
              "  });",
              "  if (typeof body.token === \"string\" && body.token.length > 0 && body.headerName === \"X-CSRF-TOKEN\") {",
              "    pm.collectionVariables.set(\"csrfToken\", body.token);",
              "  } else {",
              "    pm.execution.setNextRequest(null);",
              "  }",
              "}"
            ]
          }
        }
      ],
      "response": [],
      "protocolProfileBehavior": {
        "disableCookies": false,
        "followRedirects": false
      }
    },
    {
      "name": "04 — Get current user",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/me",
        "description": "Uses the authenticated session cookie automatically. A CSRF header is not needed for this GET."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Authenticated user response returns 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test(\"Response contains the HR identity and timeout\", function () {",
              "    pm.expect(body.user.id).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(body.user.email).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(body.user.displayName).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(body.user.roles).to.include(\"HR\");",
              "    pm.expect(body.idleTimeoutSeconds).to.be.a(\"number\").and.above(0);",
              "    pm.expect(body.user).not.to.have.property(\"password\");",
              "    pm.expect(body.user).not.to.have.property(\"passwordHash\");",
              "    pm.expect(body).not.to.have.property(\"sessionId\");",
              "  });",
              "}"
            ]
          }
        }
      ],
      "response": [],
      "protocolProfileBehavior": {
        "disableCookies": false,
        "followRedirects": false
      }
    },
    {
      "name": "05 — Get reference data",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/reference-data",
        "description": "Uses the authenticated cookie. Returns canonical filter values and currency precision. No body, query parameters or CSRF header."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Reference data returns 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test(\"All filter vocabularies are populated\", function () {",
              "    [\"countries\", \"departments\", \"jobLevels\", \"currencies\"].forEach(function (key) {",
              "      pm.expect(body[key]).to.be.an(\"array\").and.not.empty;",
              "      body[key].forEach(function (option) {",
              "        pm.expect(option.label).to.be.a(\"string\").and.not.empty;",
              "        pm.expect(option.code || option.value).to.be.a(\"string\").and.not.empty;",
              "      });",
              "    });",
              "    body.currencies.forEach(function (currency) {",
              "      pm.expect(Number.isInteger(currency.fractionDigits)).to.equal(true);",
              "      pm.expect(currency.fractionDigits).to.be.within(0, 4);",
              "    });",
              "  });",
              "}"
            ]
          }
        }
      ],
      "response": [],
      "protocolProfileBehavior": {
        "disableCookies": false,
        "followRedirects": false
      }
    },
    {
      "name": "06 — Get compensation report",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reports/compensation?groupBy=department",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reports",
            "compensation"
          ],
          "query": [
            {
              "key": "groupBy",
              "value": "department",
              "description": "Currency is always included automatically."
            },
            {
              "key": "country",
              "value": "IN",
              "disabled": true
            },
            {
              "key": "country",
              "value": "US",
              "disabled": true
            },
            {
              "key": "department",
              "value": "Engineering",
              "disabled": true
            },
            {
              "key": "jobLevel",
              "value": "L4",
              "disabled": true
            },
            {
              "key": "currency",
              "value": "INR",
              "disabled": true
            },
            {
              "key": "groupBy",
              "value": "country",
              "disabled": true
            },
            {
              "key": "groupBy",
              "value": "jobLevel",
              "disabled": true
            }
          ]
        },
        "description": "Active employees only. Uses the authenticated cookie without CSRF. Default breakdown is department plus implicit currency. Enable optional Params to filter or add dimensions. No request body. Amounts are annual base salary strings; do not combine currencies."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Compensation report returns 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test(\"Report counts and currency-separated groups are consistent\", function () {",
              "    pm.expect(body.groupBy).to.be.an(\"array\").that.includes(\"currency\");",
              "    pm.expect(body.currencySummaries).to.be.an(\"array\");",
              "    pm.expect(body.groups).to.be.an(\"array\");",
              "    pm.expect(Number.isInteger(body.totalEmployees)).to.equal(true);",
              "    pm.expect(body.totalEmployees).to.be.at.least(0);",
              "    pm.expect(body.currencySummaries.reduce((sum, row) => sum + row.employeeCount, 0)).to.equal(body.totalEmployees);",
              "    pm.expect(body.groups.reduce((sum, row) => sum + row.employeeCount, 0)).to.equal(body.totalEmployees);",
              "    [\"country\", \"department\", \"jobLevel\", \"currency\"].forEach(function (key) {",
              "      pm.expect(body.appliedFilters[key]).to.be.an(\"array\");",
              "    });",
              "    body.currencySummaries.forEach(function (summary) {",
              "      const matching = body.groups.filter(group => group.dimensions.currency === summary.currency);",
              "      pm.expect(matching.reduce((sum, group) => sum + group.employeeCount, 0)).to.equal(summary.employeeCount);",
              "    });",
              "    body.groups.forEach(function (group) {",
              "      pm.expect(Object.keys(group.dimensions).sort()).to.deep.equal(body.groupBy.slice().sort());",
              "      pm.expect(body.currencySummaries.some(summary => summary.currency === group.dimensions.currency)).to.equal(true);",
              "    });",
              "    body.currencySummaries.concat(body.groups).forEach(function (row) {",
              "      pm.expect(Number.isInteger(row.employeeCount)).to.equal(true);",
              "      pm.expect(row.employeeCount).to.be.above(0);",
              "      [\"totalAnnualBaseSalary\", \"averageAnnualBaseSalary\", \"medianAnnualBaseSalary\"].forEach(function (key) {",
              "        pm.expect(row[key]).to.be.a(\"string\").and.match(/^\\d+(?:\\.\\d+)?$/);",
              "      });",
              "    });",
              "    pm.expect(Number.isNaN(Date.parse(body.generatedAt))).to.equal(false);",
              "  });",
              "}"
            ]
          }
        }
      ],
      "response": [],
      "protocolProfileBehavior": {
        "disableCookies": false,
        "followRedirects": false
      }
    },
    {
      "name": "07 — List employees",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/employees?page=0&size=25&sort=fullName,asc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "25"
            },
            {
              "key": "sort",
              "value": "fullName,asc"
            },
            {
              "key": "q",
              "value": "EMP-000001",
              "disabled": true
            },
            {
              "key": "country",
              "value": "IN",
              "disabled": true
            },
            {
              "key": "country",
              "value": "US",
              "disabled": true
            },
            {
              "key": "department",
              "value": "Engineering",
              "disabled": true
            },
            {
              "key": "jobLevel",
              "value": "L4",
              "disabled": true
            },
            {
              "key": "currency",
              "value": "INR",
              "disabled": true
            }
          ]
        },
        "description": "Uses the authenticated cookie, with no CSRF header. Includes active/inactive employees. Enable optional search/filters in Params; repeat filter keys for multiple values. Saves the first employeeId for request 8."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Employee list returns 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test(\"Pagination metadata is consistent\", function () {",
              "    pm.expect(body.items).to.be.an(\"array\");",
              "    pm.expect(body.numberOfElements).to.equal(body.items.length);",
              "    pm.expect(body.items.length).to.be.at.most(body.size);",
              "    pm.expect(body.totalPages).to.equal(Math.ceil(body.totalElements / body.size));",
              "    pm.expect(body.hasPrevious).to.equal(body.page > 0);",
              "    pm.expect(body.hasNext).to.equal(body.page + 1 < body.totalPages);",
              "    body.items.forEach(function (employee) {",
              "      pm.expect(employee.employeeId).to.match(/^EMP-[0-9]{6}$/);",
              "      pm.expect(employee.annualBaseSalary).to.be.a(\"string\");",
              "      pm.expect(employee.currency).to.be.a(\"string\");",
              "      pm.expect(employee.employmentStatus).to.be.oneOf([\"ACTIVE\", \"INACTIVE\"]);",
              "      pm.expect(Number.isInteger(employee.version)).to.equal(true);",
              "    });",
              "  });",
              "  if (body.items.length > 0) pm.collectionVariables.set(\"employeeId\", body.items[0].employeeId);",
              "}"
            ]
          }
        }
      ],
      "response": [],
      "protocolProfileBehavior": {
        "disableCookies": false,
        "followRedirects": false
      }
    },
    {
      "name": "08 — Get employee details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/employees/{{employeeId}}",
        "description": "Uses the employeeId saved by the list or entered in collection variables. Includes inactive records; malformed IDs return 400 and missing valid IDs return 404. No body, query parameters or CSRF header."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Employee details return 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test(\"Response is the requested complete employee\", function () {",
              "    pm.expect(body.employeeId).to.equal(pm.collectionVariables.get(\"employeeId\"));",
              "    [\"fullName\", \"workEmail\", \"countryCode\", \"department\", \"jobTitle\", \"jobLevel\", \"employmentStatus\",",
              "      \"annualBaseSalary\", \"currency\", \"createdAt\", \"updatedAt\", \"joiningDate\", \"initialSalaryEffectiveFrom\", \"salaryEffectiveFrom\"]",
              "      .forEach(key => pm.expect(body[key]).to.be.a(\"string\"));",
              "    pm.expect(body).to.have.property(\"lastEmploymentDate\");",
              "    pm.expect(Number.isInteger(body.version)).to.equal(true);",
              "    pm.expect(body.version).to.be.at.least(0);",
              "    pm.expect(body).not.to.have.property(\"id\");",
              "  });",
              "}"
            ]
          }
        }
      ],
      "response": [],
      "protocolProfileBehavior": {
        "disableCookies": false,
        "followRedirects": false
      }
    },
    {
      "name": "09 — Create employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/employees",
        "description": "Create the managed employee with an initial annual base salary. Choose a unique ID/email. No version or Idempotency-Key is sent.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeId\": \"{{managedEmployeeId}}\",\n  \"fullName\": \"Ananya Iyer\",\n  \"workEmail\": \"{{managedEmployeeEmail}}\",\n  \"countryCode\": \"IN\",\n  \"department\": \"Engineering\",\n  \"jobTitle\": \"Software Engineer\",\n  \"jobLevel\": \"L3\",\n  \"annualBaseSalary\": \"960000.00\",\n  \"currency\": \"INR\",\n  \"joiningDate\": \"2026-04-01\",\n  \"initialSalaryEffectiveFrom\": \"2026-04-01\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
